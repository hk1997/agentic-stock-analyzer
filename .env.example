# API Keys
GOOGLE_API_KEY=your_api_key_here

# Model Configuration
# Options: "gemini" (default), "ollama"
MODEL_PROVIDER=gemini

# Multi-Model Configuration (Priority Order)
# Format: provider/model,provider/model,...
# Example: gemini/gemini-2.5-flash,ollama/llama3.1
LLM_ORDER=gemini/gemini-2.5-flash,ollama/llama3.1

# Model Name
# For Gemini: "gemini-2.5-flash", "gemini-1.5-pro", etc.
# For Ollama: "llama3", "mistral", "gemma", etc. (Must be pulled via `ollama pull <model>`)
MODEL_NAME=gemini-2.5-flash

# Database & Caching Layer
VALKEY_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/stock_analyzer

# --- Email Configuration (Optional) ---
# If configured, a daily portfolio update email will be sent.
RECIPIENT_EMAIL=your_email@example.com
AGENTMAIL_API_KEY=your_agentmail_api_key
AGENTMAIL_INBOX_ID=your_agentmail_inbox_id
